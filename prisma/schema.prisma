generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id          String   @id @default(cuid())
  name        String
  brand       String
  price       Float
  category    String
  condition   String
  description String
  size        String
  material    String
  coverImage  String
  sellerId    String
  createdAt   DateTime @default(now())
  seller      User     @relation(fields: [sellerId], references: [id])
}
